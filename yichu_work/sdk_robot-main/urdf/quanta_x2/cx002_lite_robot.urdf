      </geometry>
    </collision>
  </link>
  <!-- flange (aligned to v60_m3 empty link) -->
  <link name="left_flange"/>
  <!-- ==================== Joints (aligned to v60_m3) ==================== -->
  <!-- base -> shoulder_pitch  xyz z=0.177 -->
  <joint name="left_shoulder_pitch_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.177"/>
    <parent link="left_base_link"/>
    <child link="left_shoulder_pitch_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="66" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- shoulder_pitch -> shoulder_roll  rpy 90deg, no translation -->
  <joint name="left_shoulder_roll_joint" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    <parent link="left_shoulder_pitch_link"/>
    <child link="left_shoulder_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="66" lower="-2.0944" upper="2.0944" velocity="3.1416"/>
  </joint>
  <!-- shoulder_roll -> shoulder_yaw  xyz y=0.272, rpy -90deg -->
  <joint name="left_shoulder_yaw_joint" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0.272 0"/>
    <parent link="left_shoulder_roll_link"/>
    <child link="left_shoulder_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- shoulder_yaw -> elbow_roll  xyz x=0.018, rpy (-90,0,180) -->
  <joint name="left_elbow_roll_joint" type="revolute">
    <origin rpy="-1.5708 0 3.1416" xyz="0.018 0 0"/>
    <parent link="left_shoulder_yaw_link"/>
    <child link="left_elbow_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" lower="-2.5307" upper="1.0472" velocity="3.1416"/>
  </joint>
  <!-- elbow_roll -> elbow_yaw  xyz (0.018, -0.256, 0), rpy (-90,0,180) -->
  <joint name="left_elbow_yaw_joint" type="revolute">
    <origin rpy="-1.5708 0 3.1416" xyz="0.018 -0.256 0"/>
    <parent link="left_elbow_roll_link"/>
    <child link="left_elbow_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- elbow_yaw -> wrist_roll  rpy (90,-90,0), no translation -->
  <joint name="left_wrist_roll_joint" type="revolute">
    <origin rpy="1.5708 -1.5708 0" xyz="0 0 0"/>
    <parent link="left_elbow_yaw_link"/>
    <child link="left_wrist_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-1.0472" upper="1.0472" velocity="3.1416"/>
  </joint>
  <!-- wrist_roll -> wrist_pitch  same rpy as v60_m3 -->
  <joint name="left_wrist_pitch_joint" type="revolute">
    <origin rpy="1.5708 -1.5708 0" xyz="0 0 0"/>
    <parent link="left_wrist_roll_link"/>
    <child link="left_wrist_pitch_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-1.5708" upper="1.5708" velocity="3.1416"/>
  </joint>
  <!-- wrist_pitch -> flange  xyz (0,-0.086,0), rpy (0,0,-PI/2) -->
  <joint name="left_flange_joint" type="fixed">
    <origin rpy="0 0 -1.5707963267948966" xyz="0.0 -0.086 0.0"/>
    <parent link="left_wrist_pitch_link"/>
    <child link="left_flange"/>
  </joint>
  <joint name="left_arm_connector" type="fixed">
    <parent link="left_arm_base_link"/>
    <child link="left_base_link"/>
    <origin rpy="-1.5707 0 0" xyz="0 0 0"/>
  </joint>
  <ros2_control name="left_arm_control" type="system">
    <hardware>
      <plugin>shm_hardware_interface/TianjiArmSystemInterface</plugin>
      <param name="state_topic_name">left_tianji_arm/state</param>
      <param name="cmd_topic_name">left_tianji_arm/cmd</param>
    </hardware>
    <joint name="left_shoulder_pitch_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="status_word"/>
      <state_interface name="error_code"/>
      <command_interface name="control_word"/>
      <command_interface name="position"/>
      <command_interface name="effort"/>
    </joint>
    <joint name="left_shoulder_roll_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="status_word"/>
      <state_interface name="error_code"/>
      <command_interface name="control_word"/>
      <command_interface name="position"/>
      <command_interface name="effort"/>
    </joint>
    <joint name="left_shoulder_yaw_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
