  <!-- ==================== Joints (aligned to v60_m3) ==================== -->
  <!-- base -> shoulder_pitch  xyz z=0.177 -->
  <joint name="right_shoulder_pitch_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.177"/>
    <parent link="right_base_link"/>
    <child link="right_shoulder_pitch_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="66" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- shoulder_pitch -> shoulder_roll  rpy 90deg, no translation -->
  <joint name="right_shoulder_roll_joint" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="66" lower="-2.0944" upper="2.0944" velocity="3.1416"/>
  </joint>
  <!-- shoulder_roll -> shoulder_yaw  xyz y=0.272, rpy -90deg -->
  <joint name="right_shoulder_yaw_joint" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0.272 0"/>
    <parent link="right_shoulder_roll_link"/>
    <child link="right_shoulder_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- shoulder_yaw -> elbow_roll  xyz x=0.018, rpy (-90,0,180) -->
  <joint name="right_elbow_roll_joint" type="revolute">
    <origin rpy="-1.5708 0 3.1416" xyz="0.018 0 0"/>
    <parent link="right_shoulder_yaw_link"/>
    <child link="right_elbow_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="18" lower="-2.5307" upper="1.0472" velocity="3.1416"/>
  </joint>
  <!-- elbow_roll -> elbow_yaw  xyz (0.018, -0.256, 0), rpy (-90,0,180) -->
  <joint name="right_elbow_yaw_joint" type="revolute">
    <origin rpy="-1.5708 0 3.1416" xyz="0.018 -0.256 0"/>
    <parent link="right_elbow_roll_link"/>
    <child link="right_elbow_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-3.1067" upper="3.1067" velocity="3.1416"/>
  </joint>
  <!-- elbow_yaw -> wrist_roll  rpy (90,-90,0), no translation -->
  <joint name="right_wrist_roll_joint" type="revolute">
    <origin rpy="1.5708 -1.5708 0" xyz="0 0 0"/>
    <parent link="right_elbow_yaw_link"/>
    <child link="right_wrist_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-1.0472" upper="1.0472" velocity="3.1416"/>
  </joint>
  <!-- wrist_roll -> wrist_pitch  same rpy as v60_m3 -->
  <joint name="right_wrist_pitch_joint" type="revolute">
    <origin rpy="1.5708 -1.5708 0" xyz="0 0 0"/>
    <parent link="right_wrist_roll_link"/>
    <child link="right_wrist_pitch_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="6.5" lower="-1.5708" upper="1.5708" velocity="3.1416"/>
  </joint>
  <!-- wrist_pitch -> flange  xyz (0,-0.086,0), rpy (0,0,-PI/2) -->
  <joint name="right_flange_joint" type="fixed">
