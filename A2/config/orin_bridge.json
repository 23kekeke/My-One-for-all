      "required": true,
      "width": 1280,
      "height": 720
    },
    {
      "name": "left_hand_camera",
      "topic": "/aima/hal/rgbd_camera/hand_left/color/h265",
      "ros_type": "foxglove_msgs/msg/CompressedVideo",
      "kind": "video",
      "target_hz": 15.0,
      "required": true,
      "width": 640,
      "height": 480
    },
    {
      "name": "right_hand_camera",
      "topic": "/aima/hal/rgbd_camera/hand_right/color/h265",
      "ros_type": "foxglove_msgs/msg/CompressedVideo",
      "kind": "video",
      "target_hz": 15.0,
      "required": true,
      "width": 640,
      "height": 480
    },
    {
      "name": "arm_joint_state",
      "topic": "/motion/control/arm_joint_state",
      "ros_type": "sensor_msgs/msg/JointState",
      "kind": "state",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "hand_joint_state",
      "topic": "/motion/control/hand_joint_state",
      "ros_type": "sensor_msgs/msg/JointState",
