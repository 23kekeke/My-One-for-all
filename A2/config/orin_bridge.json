{
  "listen": "0.0.0.0:50061",
  "bridge_name": "a2-orin-ros2-grpc-bridge",
  "bridge_version": "0.1.0",
  "robot_id": "a2",
  "signal_target_hz": 50.0,
  "health_window_seconds": 3.0,
  "subscriber_queue_size": 2048,
