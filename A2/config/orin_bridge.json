      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "neck_joint_state",
      "topic": "/motion/control/neck_joint_state",
      "ros_type": "sensor_msgs/msg/JointState",
      "kind": "state",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "arm_joint_command",
      "topic": "/motion/control/arm_joint_command",
      "ros_type": "sensor_msgs/msg/JointState",
      "kind": "command",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "hand_joint_command",
      "topic": "/motion/control/hand_joint_command",
      "ros_type": "sensor_msgs/msg/JointState",
      "kind": "command",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "neck_joint_command",
      "topic": "/motion/control/neck_joint_command",
      "ros_type": "sensor_msgs/msg/JointState",
      "kind": "command",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "tf",
      "topic": "/tf",
      "ros_type": "tf2_msgs/msg/TFMessage",
      "kind": "tf",
      "target_hz": 50.0,
      "required": true
    },
    {
      "name": "tf_static",
      "topic": "/tf_static",
      "ros_type": "tf2_msgs/msg/TFMessage",
      "kind": "tf_static",
      "target_hz": 0.0,
      "required": true
    }
